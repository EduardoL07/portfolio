---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ThemedImage from '../../components/ThemedImage.astro';
import { site, links } from '../../data/site';
import { stepIcons } from '../../data/stepIcons';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, index, next } = Astro.props;
const data = entry.data;
const pad = (n: number) => String(n).padStart(2, '0');
const ficha = [
  ['Papel', data.role],
  ['Duração', data.duration],
  ['Ferramentas', data.tools],
  ['Ano', data.year],
];
---

<Base title={`${data.title} — ${site.name}`} description={data.summary}>
  <article>
    <header class="case-hero container">
      <a class="label muted back" href="/#cases" data-reveal>← Todos os cases</a>
      <p class="overline faint" data-reveal>Case {pad(index + 1)} — {data.year}</p>
      <h1 class="display" data-reveal>{data.title}</h1>
      <p class="body-l muted case-hero__sub" data-reveal>{data.summary}</p>
    </header>

    <dl class="ficha container" data-reveal>
      {
        ficha.map(([label, value]) => (
          <div>
            <dt class="overline faint">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="container" data-reveal>
      <div class="cover">
        <Image
          src={data.detailCover ?? data.cover}
          alt={`Capa do case ${data.title}`}
          widths={[640, 1280]}
          sizes="90vw"
          loading="eager"
        />
      </div>
    </div>

    {
      data.metrics.length > 0 && (
        <ul class="metrics container">
          {data.metrics.map((metric) => (
            <li data-reveal>
              <span class="h1">{metric.value}</span>
              <span class="muted">{metric.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="container blocks">
      {
        data.sections.map((block, i) => (
          <section class="block" data-reveal>
            <p class="overline muted">
              {pad(i + 1)} — {block.label}
            </p>
            <div class="block__text">
              <h2 class="h2">{block.title}</h2>
              <p class="body-l muted block__body">{block.body}</p>

              {block.image && (
                <div class="block__image">
                  <ThemedImage
                    image={block.image}
                    dark={block.imageDark}
                    widths={[700, 1200, 1792]}
                    sizes="(min-width: 900px) 62vw, 90vw"
                  />
                </div>
              )}

              {block.steps.length > 0 && (
                <ol class="steps">
                  {block.steps.map((step, k) => (
                    <li class="step">
                      <div class="step__head">
                        {step.icon && (
                          <svg class="step__icon" viewBox="0 0 50 50" fill="none" aria-hidden="true" set:html={stepIcons[step.icon]} />
                        )}
                        <span class="overline">{pad(k + 1)}</span>
                      </div>
                      <div class="step__text">
                        <h3 class="h3">{step.title}</h3>
                        <p>{step.body}</p>
                      </div>
                      {step.decision && (
                        <div class="step__decision">
                          <span class="overline">Decisão</span>
                          <p class="label">{step.decision}</p>
                        </div>
                      )}
                    </li>
                  ))}
                </ol>
              )}

              {block.card && (
                <div class="insight">
                  <div class="insight__text">
                    {block.card.tag && <span class="insight__tag">✓ {block.card.tag}</span>}
                    <h3 class="insight__title">{block.card.title}</h3>
                    <p class="insight__body">{block.card.body}</p>
                    {block.card.stats.length > 0 && (
                      <ul class="insight__stats">
                        {block.card.stats.map((stat) => (
                          <li class={`stat stat--${stat.tone}`}>
                            <span class="stat__value">{stat.value}</span>
                            <span class="stat__label">{stat.label}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                  {block.card.phone && (
                    <div class="insight__phone">
                      <Image src={block.card.phone} alt="" widths={[471, 942]} sizes="(min-width: 900px) 440px, 80vw" />
                    </div>
                  )}
                </div>
              )}
            </div>
          </section>
        ))
      }
    </div>

    {
      data.gallery.length > 0 && (
        <section class="container gallery">
          <div class="section-intro" data-reveal>
            <div class="section-header">
              <span class="overline muted">
                {pad(data.sections.length + 1)} — Telas finais
              </span>
            </div>
            <h2 class="h1">
              Telas <span class="serif">finais</span>
            </h2>
          </div>
          <div class="gallery__grid">
            {data.gallery.map((item) => (
              <div class:list={['gallery__item', item.wide && 'gallery__item--wide']} data-reveal>
                <ThemedImage
                  image={item.image}
                  dark={item.imageDark}
                  widths={item.wide ? [640, 1280, 2560] : [640, 1280]}
                  sizes={item.wide ? '90vw' : '(min-width: 900px) 45vw, 90vw'}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <aside class="container behance" data-reveal>
      <div class="behance__card">
        <div class="behance__text">
          <h2 class="h3">Prefere ver tudo de uma vez?</h2>
          <p class="muted">A versão completa do projeto também está no Behance.</p>
        </div>
        <a class="btn btn--outline" href={data.behance ?? links.behance} target="_blank" rel="noopener">
          <svg class="behance__logo" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16.969 16.927a2.561 2.561 0 0 0 1.901.677 2.501 2.501 0 0 0 1.531-.475c.362-.235.636-.584.779-.99h2.585a5.091 5.091 0 0 1-1.9 2.896 5.292 5.292 0 0 1-3.091.88 5.839 5.839 0 0 1-2.284-.433 4.871 4.871 0 0 1-1.723-1.211 5.657 5.657 0 0 1-1.08-1.874 7.057 7.057 0 0 1-.383-2.393c-.005-.8.129-1.595.396-2.349a5.313 5.313 0 0 1 5.088-3.604 4.87 4.87 0 0 1 2.376.563c.661.362 1.231.87 1.668 1.485a6.2 6.2 0 0 1 .943 2.133c.194.821.263 1.666.205 2.508h-7.699c-.063.79.184 1.574.688 2.187ZM6.947 4.084a8.065 8.065 0 0 1 1.928.198 4.29 4.29 0 0 1 1.49.638c.418.303.748.711.958 1.182.241.579.357 1.203.341 1.83a3.506 3.506 0 0 1-.506 1.961 3.726 3.726 0 0 1-1.503 1.287 3.588 3.588 0 0 1 2.027 1.437c.464.747.697 1.615.67 2.494a4.593 4.593 0 0 1-.423 2.032 3.945 3.945 0 0 1-1.163 1.413 5.114 5.114 0 0 1-1.683.807 7.135 7.135 0 0 1-1.928.259H0V4.084h6.947Zm-.235 12.9c.308.004.616-.029.916-.099a2.18 2.18 0 0 0 .766-.332c.228-.158.411-.371.534-.619.142-.317.208-.663.191-1.009a2.08 2.08 0 0 0-.642-1.715 2.618 2.618 0 0 0-1.696-.505h-3.54v4.279h3.471Zm13.635-5.967a2.13 2.13 0 0 0-1.654-.619 2.336 2.336 0 0 0-1.163.259 2.474 2.474 0 0 0-.738.62 2.359 2.359 0 0 0-.396.792c-.074.239-.12.485-.137.734h4.769a3.239 3.239 0 0 0-.679-1.785l-.002-.001Zm-13.813-.648a2.254 2.254 0 0 0 1.423-.433c.399-.355.607-.88.56-1.413a1.916 1.916 0 0 0-.178-.891 1.298 1.298 0 0 0-.495-.533 1.851 1.851 0 0 0-.711-.274 3.966 3.966 0 0 0-.835-.073H3.241v3.631h3.293v-.014ZM21.62 5.122h-5.976v1.527h5.976V5.122Z"
            />
          </svg>
          Ver projeto no Behance ↗
        </a>
      </div>
    </aside>

    <nav class="container next" aria-label="Próximo case">
      <a class="next__link" href={`/cases/${next.id}/`} data-reveal>
        <div class="next__text">
          <span class="overline next__hat">Próximo case</span>
          <span class="h1">{next.data.title} ↗</span>
        </div>
        <div class="next__cover">
          <Image src={next.data.cover} alt="" widths={[440, 880]} sizes="(min-width: 900px) 440px, 90vw" />
        </div>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case-hero {
    display: grid;
    gap: clamp(24px, 2.8vw, 40px);
    padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 100px));
    padding-bottom: clamp(48px, 5.5vw, 80px);
  }

  .back:hover {
    color: var(--text-primary);
  }

  .case-hero__sub {
    max-width: 760px;
  }

  .ficha {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
    margin-block: 0 clamp(48px, 5.5vw, 80px);
  }

  .ficha > div {
    padding-top: clamp(16px, 1.4vw, 20px);
    border-top: 1px solid var(--border-subtle);
  }

  .ficha dd {
    margin: 8px 0 0;
  }

  .cover {
    overflow: hidden;
    border-radius: clamp(20px, 1.7vw, 24px);
    background: var(--bg-surface);
    aspect-ratio: 16 / 9;
  }

  .cover :global(img),
  .next__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .metrics {
    display: grid;
    gap: 24px;
    padding-block: clamp(64px, 8.3vw, 120px);
  }

  .metrics li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: clamp(16px, 1.7vw, 24px);
    border-top: 1px solid var(--border-strong);
  }

  .block {
    display: grid;
    gap: 20px;
    padding-top: clamp(20px, 2.8vw, 40px);
    padding-bottom: clamp(56px, 6.7vw, 96px);
    border-top: 1px solid var(--border-subtle);
  }

  .block__text {
    display: grid;
    gap: 24px;
    min-width: 0;
  }

  .block__body {
    max-width: 760px;
  }

  /* As imagens exportadas já trazem o fundo e os cantos arredondados do layout */
  .block__image :global(img),
  .gallery__item :global(img) {
    width: 100%;
    height: auto;
  }

  /* Etapas do processo: card com as etapas numeradas e a decisão de cada uma */
  .steps {
    display: grid;
    gap: 28px;
    padding: 20px;
    border-radius: clamp(16px, 1.4vw, 20px);
    background: var(--bg-surface);
  }

  .step {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .step__head {
    display: flex;
    align-items: flex-start;
  }

  .step__head .overline {
    margin-left: auto;
  }

  .step__icon {
    width: 40px;
    height: 40px;
  }

  .step__text {
    display: grid;
    gap: 8px;
  }

  .step__decision {
    display: grid;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--border-strong);
  }

  /* Card de destaque: texto + números de um lado, celular do outro */
  .insight {
    --good: #2f7d4d;
    --warn: #c0602e;
    display: grid;
    overflow: hidden;
    border-radius: clamp(16px, 1.4vw, 20px);
    background: var(--bg-surface);
  }

  :global([data-theme='dark']) .insight {
    --good: #3ddc84;
    --warn: #e07a45;
  }

  .insight__text {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: clamp(20px, 1.7vw, 24px);
  }

  .insight__tag {
    justify-self: start;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bg-base);
    color: var(--good);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .insight__title {
    font-size: clamp(1.375rem, 1.95vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .insight__body {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .insight__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 16px;
    margin-top: 8px;
  }

  .stat {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--bg-base);
  }

  .stat__value {
    font-size: clamp(1.75rem, 2.35vw, 2.125rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .stat--good .stat__value {
    color: var(--good);
  }

  .stat--warn .stat__value {
    color: var(--warn);
  }

  .stat__label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .insight__phone {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-top: 8px;
  }

  .insight__phone :global(img) {
    width: min(100%, 320px);
    height: auto;
  }

  .gallery {
    padding-bottom: clamp(80px, 11vw, 160px);
  }

  .gallery__grid {
    display: grid;
    gap: clamp(12px, 1.7vw, 24px);
  }

  /* CTA para a versão completa no Behance, logo antes do próximo case */
  .behance {
    padding-bottom: clamp(48px, 5.5vw, 80px);
  }

  .behance__card {
    display: grid;
    gap: 24px;
    padding: 24px;
    border-radius: clamp(16px, 1.4vw, 20px);
    background: var(--bg-surface);
  }

  .behance__text {
    display: grid;
    gap: 8px;
  }

  .behance__logo {
    width: 18px;
    height: 18px;
    flex: none;
  }

  @media (max-width: 899px) {
    .behance .btn {
      width: 100%;
    }
  }

  .next {
    padding-bottom: clamp(64px, 8.3vw, 120px);
  }

  .next__link {
    display: grid;
    gap: 20px;
    padding-top: clamp(24px, 2.8vw, 40px);
    border-top: 1px solid var(--border-subtle);
  }

  .next__text {
    display: grid;
    gap: clamp(20px, 1.7vw, 24px);
    align-content: end;
  }

  /* Mesma receita do selo de disponibilidade do hero: pill com fundo de contraste */
  .next__hat {
    justify-self: start;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--bg-inverse);
    color: var(--text-on-inverse);
  }

  .next__cover {
    overflow: hidden;
    border-radius: clamp(16px, 1.4vw, 20px);
    background: var(--bg-surface);
    aspect-ratio: 440 / 260;
  }

  .next__cover :global(img) {
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .next__link:hover .next__cover :global(img) {
    transform: scale(1.03);
  }

  @media (min-width: 900px) {
    .ficha {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }

    .metrics {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    .block {
      grid-template-columns: minmax(160px, 320px) 1fr;
      gap: 64px;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 32px;
      padding: 32px;
    }

    .step__icon {
      width: 50px;
      height: 50px;
    }

    .insight {
      grid-template-columns: 1fr 1fr;
    }

    .insight__phone {
      padding-top: 24px;
    }

    .insight__phone :global(img) {
      width: min(100%, 471px);
    }

    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery__item--wide {
      grid-column: 1 / -1;
    }

    .behance__card {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 32px;
      padding: 40px;
    }

    .next__link {
      grid-template-columns: 1fr 440px;
      align-items: end;
    }
  }
</style>
